/* Override spi22 to be SPI slave */

&pinctrl {
	spi22_slave_default: spi22_slave_default {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 3, 3)>,
				<NRF_PSEL(SPIS_MOSI, 3, 0)>,
				<NRF_PSEL(SPIS_MISO, 3, 1)>,
				<NRF_PSEL(SPIS_CSN, 3, 2)>;
		};
	};

	spi22_slave_sleep: spi22_slave_sleep {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 3, 3)>,
				<NRF_PSEL(SPIS_MOSI, 3, 0)>,
				<NRF_PSEL(SPIS_MISO, 3, 1)>,
				<NRF_PSEL(SPIS_CSN, 3, 2)>;
			low-power-enable;
		};
	};
};

&spi22 {
	compatible = "nordic,nrf-spis";
	status = "okay";
	def-char = <0xAA>;
	pinctrl-0 = <&spi22_slave_default>;
	pinctrl-1 = <&spi22_slave_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ cs-gpios;
	/delete-property/ rx-delay-supported;
	/delete-property/ rx-delay;
	/delete-property/ zephyr,pm-device-runtime-auto;
};
